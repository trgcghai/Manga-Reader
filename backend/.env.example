# Backend API
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:4000

# PostgreSQL
DB_HOST=localhost
DB_PORT=4004
DB_USERNAME=manga
DB_PASSWORD=replace-me
DB_NAME=manga_reader

# MongoDB and Redis
MONGODB_URI=mongodb://manga:replace-me@localhost:4003/manga_reader?authSource=admin
