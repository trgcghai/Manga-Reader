# S3 compatible object storage (MinIO for local development)
STORAGE_ENDPOINT=http://localhost:4005
STORAGE_PUBLIC_URL=http://localhost:4005
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace-me
STORAGE_SECRET_KEY=replace-me
STORAGE_BUCKET=manga-pages
