# Published host ports
BACKEND_PORT=3001
FRONTEND_PORT=3000

# Backend runtime
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://manga.example.com
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=replace-with-a-secret
DB_NAME=manga_reader
MONGODB_URI=mongodb://your-mongodb-host:27017/manga_reader
REDIS_URL=redis://your-redis-host:6379

# S3 compatible object storage. Leave STORAGE_ENDPOINT empty for AWS S3.
# The bucket must already exist and have the access policy your deployment needs.
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=https://storage.example.com
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace-with-access-key
STORAGE_SECRET_KEY=replace-with-secret-key
STORAGE_BUCKET=manga-pages

# Embedded in the frontend bundle at image build time; use a URL reachable by browsers.
VITE_API_URL=http://localhost:3001
